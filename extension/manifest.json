{
  "manifest_version": 3,
  "name": "LCForge",
  "version": "1.1.0",
  "description": "Send the LeetCode problem you are viewing to LCForge, the Java debugger running on your own computer.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:7070/*",
    "http://127.0.0.1:7071/*",
    "http://127.0.0.1:7072/*",
    "http://127.0.0.1:7073/*",
    "http://127.0.0.1:7074/*",
    "http://127.0.0.1:7075/*",
    "http://127.0.0.1:7076/*",
    "http://127.0.0.1:7077/*",
    "http://127.0.0.1:7078/*",
    "http://127.0.0.1:7079/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://www.leetcode.com/problems/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
